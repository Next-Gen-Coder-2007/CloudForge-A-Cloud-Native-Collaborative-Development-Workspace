# ==============================================================================
# CloudForge Backend Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# The Public HTTPS URL of your deployed Frontend (Required for CORS & WebSocket Security)
# Examples:
#   CLIENT_URL=https://cloudforge.vercel.app
#   CLIENT_URL=https://cloudforge.yourdomain.com
CLIENT_URL=https://cloudforge.vercel.app

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Atlas / Cloud MongoDB)
# ------------------------------------------------------------------------------
# Get your free connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/cloudforge?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# A strong random secret key (e.g. generated via `openssl rand -base64 48`)
JWT_SECRET=cf_prod_super_secret_jwt_key_at_least_32_chars_long

# ------------------------------------------------------------------------------
# 4. Cloud Container Execution Engine (Choose ONE Option Below)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# OPTION A: Fly.io Machines Cloud MicroVM API (Recommended: Instant & Serverless)
# ------------------------------------------------------------------------------
# Generate your token at https://fly.io/user/personal_access_tokens
FLY_API_TOKEN=fo1_your_fly_api_personal_access_token
FLY_APP_NAME=cloudforge-workspaces
FLY_REGION=iad

# ------------------------------------------------------------------------------
# OPTION B: Dedicated CloudForge Container Runner Service
# ------------------------------------------------------------------------------
# CLOUD_RUNNER_API_URL=https://runner.cloudforge.dev
# CLOUD_RUNNER_API_KEY=cf_live_sec_your_secret_runner_key
# CLOUD_RUNNER_REGION=us-east-1 (Cloud)

# ------------------------------------------------------------------------------
# OPTION C: Remote Cloud Docker Host over HTTPS / mTLS (AWS EC2 / DigitalOcean / VPS)
# ------------------------------------------------------------------------------
# DOCKER_HOST=tcp://docker-worker.yourdomain.com:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/etc/cloudforge/certs/docker
# REMOTE_CONTAINER_HOST=docker-worker.yourdomain.com

# In-Memory TLS Certificates (Alternative when deploying to Render / Railway / Fly):
# DOCKER_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DOCKER_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DOCKER_CLIENT_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# OPTION D: Local Docker Daemon (Inside VPS or Container with /var/run/docker.sock)
# ------------------------------------------------------------------------------
# DOCKER_SOCKET=/var/run/docker.sock

# ------------------------------------------------------------------------------
# 5. Storage Isolation Mode
# ------------------------------------------------------------------------------
# 'cloud' uses Docker Named Volumes + streaming API (recommended for production)
CLOUDFORGE_STORAGE_MODE=cloud
